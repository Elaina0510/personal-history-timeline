{
  "name": "personal-history-timeline",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server.js",
    "serve": "node server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync:dev": "node scripts/dev-sync.mjs",
    "cf:kv": "wrangler kv namespace create TIMELINE_KV",
    "cf:secret": "wrangler secret put SYNC_TOKEN",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@cloudflare/workerd-windows-64": "^1.20261118.1",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^2.1.8",
    "wrangler": "^4.165.0"
  }
}
